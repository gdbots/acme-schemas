{
  "name": "gdbots/acme-schemas",
  "homepage": "https://github.com/gdbots/acme-schemas",
  "description": "Sample schemas for common gdbots services",
  "type": "pbj-schema-store",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.5.12",
    "gdbots/schemas": "3.1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "gdbots/pbjc": "v1.x-dev",
    "symfony/yaml": "^8.1"
  },
  "autoload": {
    "files": [
      "build/php/src/pbj-schemas.php"
    ],
    "psr-0": {
      "": "build/php/src"
    }
  },
  "autoload-dev": {
    "files": [
      "pbj-schema-stores.php"
    ],
    "psr-0": {
      "": "build/php/tests"
    }
  },
  "scripts": {
    "pbjc": [
      "vendor/bin/pbjc",
      "git add .",
      "@test"
    ],
    "test": [
      "vendor/bin/phpunit",
      "npm test"
    ]
  }
}
